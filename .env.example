# ============================================================
# VARIABLES DE ENTORNO — DESARROLLO LOCAL
# Copia este archivo como ".env" y llena los valores.
# Para producción (Vercel) mira .env.production.example
# ============================================================

# Clave secreta de Payload (firma las sesiones del panel). Cualquier texto largo y aleatorio.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Base de datos. Vacío = usa el archivo SQLite local "barber.db" (no necesitas instalar nada).
# Si pones una URL postgres://... se conecta a Postgres (por ejemplo, una rama de Neon para pruebas).
DATABASE_URI=

# URL del sitio (SEO, enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos push de la app "Mi agenda" (/panel).
# Genera el par de claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Vercel Blob. Vacío en local = las fotos se guardan en public/media.
BLOB_READ_WRITE_TOKEN=

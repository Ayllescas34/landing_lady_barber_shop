# ============================================================
# VARIABLES DE ENTORNO — PRODUCCIÓN (Vercel)
# Lady Barbershop Antigua
# ============================================================
# Vercel → tu proyecto → Settings → Environment Variables
# ============================================================

# ----------------------------------------------------------
# BASE DE DATOS — Neon Postgres (OBLIGATORIO)
# Vercel → Storage → Create → Neon. Al conectarla al proyecto, Vercel crea
# DATABASE_URL automáticamente (no hay que copiar nada).
# Si la pones a mano, usa la URL con "-pooler" y ?sslmode=require.
# Las tablas se crean solas en el primer deploy (migraciones de src/migrations).
# ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------
# FOTOS — Vercel Blob (OBLIGATORIO)
# Vercel → Storage → Create → Blob. Al conectarlo, Vercel crea este token solo.
# ----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# ----------------------------------------------------------
# PAYLOAD CMS (OBLIGATORIO)
# Clave larga y aleatoria. Si la cambias, se cierran todas las sesiones.
# ----------------------------------------------------------
PAYLOAD_SECRET=reemplaza-con-una-clave-larga-y-aleatoria

# ----------------------------------------------------------
# URL PÚBLICA (OBLIGATORIO). Dominio final, sin barra al final.
# ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ----------------------------------------------------------
# AVISOS PUSH de la app "Mi agenda" (OBLIGATORIO para notificaciones)
# Genera con: npx web-push generate-vapid-keys
# Si cambias estas claves, hay que volver a "Activar avisos" en el iPhone.
# VAPID_SUBJECT: un correo de contacto real (lo pide Apple).
# ----------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
